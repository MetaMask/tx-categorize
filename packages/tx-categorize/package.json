{
  "name": "@metamask/tx-categorize",
  "version": "2.1.5",
  "description": "A library for categorizing and labeling blockchain transactions",
  "author": "Consensys Software Inc.",
  "license": "ISC",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "categorize": "yarn build && node ./scripts/categorize.js",
    "list:metrics": "yarn build && node ./scripts/listMetrics.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --ci --coverage",
    "release": "standard-version",
    "tscheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/i18next": "^13.0.0",
    "@types/jest": "^27.4.1",
    "@types/node": "^18.19.45",
    "eslint": "^10.2.0",
    "jest": "^29.7.0",
    "nock": "^13.2.4",
    "standard-version": "^9.3.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.58.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/tx-categorize.git"
  },
  "dependencies": {
    "@metamask/utils": "^11.10.0",
    "axios": "^1.16.0",
    "i18next": "^24.2.3",
    "i18next-fs-backend": "^2.6.6"
  }
}
