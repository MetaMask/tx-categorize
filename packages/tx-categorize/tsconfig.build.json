{
  "extends": "../../tsconfig.packages.build.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["./src", "./src/**/*.json"],
  "exclude": [
    "./test-fixtures/**/*",
    "./src/**/*.test.ts",
    "./src/**/*.test.js",
    "./src/**/testCases.mock.ts",
    "./src/**/__tests__/**/*",
    "./src/**/__mocks__/**/*",
    "./src/**/__fixtures__/**/*",
    "./src/**/__snapshots__/**/*"
  ]
}
